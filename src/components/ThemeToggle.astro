---
import IconMoon from "@/assets/icons/moon.svg";
import IconSun from "@/assets/icons/sun.svg";
---

<button class="theme-toggle" aria-label="Toggle theme">
  <span class="icon-sun"><IconSun /></span>
  <span class="icon-moon"><IconMoon /></span>
</button>

<style>
  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 1em 0.5em;
    color: var(--color-700);
    display: grid;
    place-items: center;
    border-radius: 6px;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }
  .theme-toggle:hover {
    color: var(--color-900);
    background: var(--color-300);
  }
  .theme-toggle:active {
    transform: scale(0.92);
  }
  .icon-sun,
  .icon-moon {
    grid-area: 1 / 1;
    display: flex;
    pointer-events: none;
    transition:
      opacity var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
  }
  :global(:root[data-theme="dark"]) .icon-sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
  :global(:root[data-theme="dark"]) .icon-moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  :global(:root:not([data-theme="dark"])) .icon-sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  :global(:root:not([data-theme="dark"])) .icon-moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .icon-sun,
    .icon-moon {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    function setTheme(theme) {
      if (theme === "dark") {
        document.documentElement.setAttribute("data-theme", "dark");
      } else {
        document.documentElement.removeAttribute("data-theme");
      }
      localStorage.setItem("theme", theme);
    }

    if (!window.__themeToggleInit) {
      window.__themeToggleInit = true;
      document.addEventListener("click", function (e) {
        if (e.target.closest(".theme-toggle")) {
          var isDark = document.documentElement.getAttribute("data-theme") === "dark";
          setTheme(isDark ? "light" : "dark");
        }
      });
    }
  })();
</script>
