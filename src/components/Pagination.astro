---
import IconLeft from "@/assets/icons/chevron-left.svg";
import IconRight from "@/assets/icons/chevron-right.svg";
import { _t } from "@/config";

interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl: rawBaseUrl } = Astro.props;

// Handle root domain (when BASE_URL is '/' or empty)
const base = import.meta.env.BASE_URL === '/' || !import.meta.env.BASE_URL ? '' : import.meta.env.BASE_URL.replace(/\/+$/, '');

// Clean up and construct the correct base URL for pagination
let cleanBaseUrl = rawBaseUrl.startsWith('/') ? rawBaseUrl : `/${rawBaseUrl}`;
if (base && cleanBaseUrl.startsWith(base)) {
  cleanBaseUrl = cleanBaseUrl.slice(base.length);
}
const finalBaseUrl = `${base}${cleanBaseUrl}`.replace(/\/+/g, '/');

const hasPrevPage = currentPage > 1;
const hasNextPage = currentPage < totalPages;
const prevPageUrl = currentPage - 1 === 1 ? finalBaseUrl : `${finalBaseUrl}/${currentPage - 1}`;
const nextPageUrl = `${finalBaseUrl}/${currentPage + 1}`;
---

<>
  {
    totalPages > 1 && (
      <nav class="pagination" aria-label="Pagination">
        {hasPrevPage ? (
          <a href={prevPageUrl} data-astro-prefetch>
            <IconLeft /> {_t.pagination.prev}
          </a>
        ) : (
          <span class="disabled">
            <IconLeft /> {_t.pagination.prev}
          </span>
        )}

        <span class="current">
          {currentPage} / {totalPages}
        </span>

        {hasNextPage ? (
          <a href={nextPageUrl} data-astro-prefetch>
            {_t.pagination.next} <IconRight />
          </a>
        ) : (
          <span class="disabled">
            {_t.pagination.next} <IconRight />
          </span>
        )}
      </nav>
    )
  }
</>

<style>
  .pagination {
    font-size: var(--font-size-sm);
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    justify-content: center;
    /* align-items: center; */
  }
  .pagination a,
  .pagination span {
    text-decoration: none;
    display: flex;
    align-items: center;
  }
  .pagination .disabled {
    color: var(--color-700);
  }
</style>
