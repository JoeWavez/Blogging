---
import IconDotsVertical from "@/assets/icons/dots-vertical.svg";
import IconSearch from "@/assets/icons/search.svg";
import IconX from "@/assets/icons/x.svg";
import HeaderLink from "@/components/HeaderLink.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { _t, SITE } from "@/config";

const base = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL.replace(/\/+$/, "");
const homeUrl = `${base}/`;
const postsUrl = `${base}/posts`;
const searchUrl = `${base}/search`;
---

<header>
  <nav aria-label="Main navigation">
    <span class="site-title"><a href={homeUrl}>{SITE.title}</a></span>
    <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
      <IconDotsVertical class="icon-open" />
      <IconX class="icon-close" />
    </button>
    <div class="internal-links">
      <HeaderLink href={postsUrl}>{_t.posts.title}</HeaderLink>
      <HeaderLink href={searchUrl} class="header-icon-link" aria-label={_t.search.title}
        ><IconSearch class="search-icon" /><span class="search-label">{_t.search.title}</span
        ></HeaderLink
      >
      <ThemeToggle />
    </div>
  </nav>
</header>

<script is:inline define:vars={{ __DEV__: import.meta.env.DEV }}>
  (function () {
    function initMenu() {
      if (__DEV__) console.debug("init header menu");

      const toggle = document.querySelector(".menu-toggle");
      const header = document.querySelector("header");
      if (!toggle || !header) return;

      toggle.addEventListener("click", () => {
        if (__DEV__) console.debug("toggle header menu");
        const open = header.classList.toggle("open");
        toggle.setAttribute("aria-expanded", String(open));
      });
    }

    function initHeaderShadow() {
      const header = document.querySelector("header");
      if (!header) return;

      const update = () => header.classList.toggle("scrolled", window.scrollY > 4);
      update();
      window.addEventListener("scroll", update, { passive: true });
    }

    document.addEventListener("astro:page-load", initMenu);
    document.addEventListener("astro:page-load", initHeaderShadow);
  })();
</script>

<style>
  @import "../styles/breakpoints.css";

  header {
    margin: 0;
    padding: 0.5em 1em;
    border: none;
    border-bottom: 1px solid var(--color-500);
    font-weight: var(--font-weight-light);
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--color-100) 82%, transparent);
    backdrop-filter: blur(12px) saturate(160%);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
    transition:
      box-shadow var(--duration-normal) var(--ease-out),
      background-color var(--duration-normal) var(--ease-out);
  }
  header.scrolled {
    box-shadow:
      0 1px 0 var(--color-500),
      0 8px 24px -16px var(--color-shadow);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    header {
      background: var(--color-100);
    }
  }
  @media (--bp-md) {
    header {
      padding: 0 3em;
    }
  }
  .site-title {
    margin: 0;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
  }
  .site-title a,
  .site-title a.active {
    color: var(--color-900);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .internal-links {
    display: flex;
    align-items: center;
  }
  nav a {
    padding: 1em;
    color: var(--color-700);
    border-bottom: 2px solid transparent;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }
  nav a:hover {
    color: var(--color-900);
  }
  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--color-900);
  }
  :global(nav a.header-icon-link) {
    display: flex;
    align-items: center;
    gap: 0.35em;
  }
  :global(.search-label) {
    display: none;
  }

  :global(.icon-close) {
    display: none;
  }
  :global(header.open .icon-open) {
    display: none;
  }
  :global(header.open .icon-close) {
    display: block;
  }

  /* mobile menu */
  .menu-toggle {
    display: none;
    background: none;
    border: none;
    padding: 0.5em;
    cursor: pointer;
    color: var(--color-900);
    line-height: 0;
    border-radius: 6px;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }
  .menu-toggle:hover {
    background: var(--color-300);
  }
  .menu-toggle:active {
    transform: scale(0.92);
  }

  @media not (--bp-md) {
    :global(.search-icon) {
      display: none;
    }
    :global(.search-label) {
      display: inline;
    }
    .menu-toggle {
      display: flex;
      align-items: center;
    }
    .internal-links {
      display: none;
    }
    :global(header.open) nav {
      flex-wrap: wrap;
    }
    :global(header.open) .internal-links {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      animation: menu-drop var(--duration-normal) var(--ease-out);
      transform-origin: top;
    }
  }

  @keyframes menu-drop {
    from {
      opacity: 0;
      transform: translateY(-0.5em);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    header,
    header.scrolled,
    .site-title a,
    nav a,
    .menu-toggle,
    :global(header.open) .internal-links {
      transition: none;
      animation: none;
    }
  }
</style>
