---
import FormattedDate from "@/components/FormattedDate.astro";

interface Props {
  id: string;
  title: string;
  description?: string;
  date: Date;
  updated?: Date;
  image?: string;
}

const { id, title, description, date, updated, image } = Astro.props;

// Adapt to root domain or subpath automatically
const base = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL.replace(/\/+$/, "");
const postUrl = `${base}/posts/${id}`;
---

<a href={postUrl} data-astro-prefetch>
  <div class="card">
    {image && <img src={image} alt={title} class="card-image" />}
    <h2>{title}</h2>
    {description && <p class="desc">{description}</p>}
    <p class="date">
      <FormattedDate date={updated ?? date} />
    </p>
  </div>
</a>

<style>
  .card {
    padding-bottom: 1.5rem;
  }
  .card-image {
    width: 100%;
    height: 385px;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 0.75rem;
  }
  a {
    display: block;
    text-decoration: none;
    transition: transform var(--duration-normal) var(--ease-out);
  }
  a:hover {
    transform: translateY(-2px);
  }
  h2 {
    margin: 0 0 0.5rem 0;
    font-size: var(--font-size-xl);
    line-height: 1.2;
    letter-spacing: -0.01em;
    background-image: linear-gradient(var(--color-900), var(--color-900));
    background-repeat: no-repeat;
    background-size: 0% 1.5px;
    background-position: 0 100%;
    transition:
      background-size var(--duration-normal) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  a:hover h2 {
    background-size: 100% 1.5px;
    color: var(--color-700);
  }
  p {
    margin: 0.125rem 0 0 0;
  }
  .desc {
    color: var(--color-700);
    font-size: var(--font-size-md);
  }
  .date {
    color: var(--color-700);
    font-size: var(--font-size-sm);
  }
  @media (prefers-reduced-motion: reduce) {
    a,
    h2 {
      transition: none;
    }
  }
</style>
