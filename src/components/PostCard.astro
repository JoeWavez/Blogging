---
import FormattedDate from "@/components/FormattedDate.astro";

interface Props {
  id: string;
  title: string;
  description?: string;
  date: Date;
  updated?: Date;
  // tags?: string[];
  // category?: string[];
}

const { id, title, description, date, updated } = Astro.props;

// Ensure BASE_URL ends cleanly with a single slash before appending paths
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

const postUrl = `${baseUrl}posts/${id}`;
---

<a href={postUrl} data-astro-prefetch>
  <div class="card">
    <h2>{title}</h2>
    {description && <p class="desc">{description}</p>}
    <p class="date">
      <FormattedDate date={updated ?? date} />
    </p>
  </div>
</a>

<style>
  .card {
    padding-bottom: 1.5rem;
  }
  a {
    text-decoration: none;
  }
  h2 {
    margin: 0 0 0.5rem 0;
    font-size: var(--font-size-xl);
    line-height: 1.2;
  }
  p {
    margin: 0.125rem 0 0 0;
  }
  .desc {
    color: var(--color-700);
    font-size: var(--font-size-md);
  }
  .date {
    color: var(--color-700);
    font-size: var(--font-size-sm);
  }
</style>
