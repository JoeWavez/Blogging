---
import { getCollection, render } from "astro:content";
import "@/styles/post.css";
import { _t } from "@/config";
import BaseLayout from "@/layouts/BaseLayout.astro";

let ContentComponent = null;

try {
  const aboutCollection = await getCollection("about");
  if (aboutCollection && aboutCollection.length > 0) {
    const { Content } = await render(aboutCollection[0]);
    ContentComponent = Content;
  }
} catch (e) {
  console.log("Collection build fallback triggered");
}
---

<BaseLayout title="About" description="About JoeWaves">
  <main id="main-content">
    <section>
      <div class="title">
        <h1>About</h1>
      </div>
      <div class="main-content" data-pagefind-body>
        {ContentComponent ? (
          <ContentComponent />
        ) : (
          <div>
            <p>Hi I'm JoeWaves! I built this blog to share personal things and projects I'm working on. I hope you guys can check up every so often for new posts, thanks!</p>
            <ul>
              <li>JoeWaves</li>
            </ul>
          </div>
        )}
      </div>
    </section>
  </main>
</BaseLayout>
